# Backend aktif: laravel | fiber  (ganti DI SINI untuk berpindah backend)
VITE_BACKEND=laravel

VITE_API_LARAVEL=http://127.0.0.1:8000/api
VITE_API_FIBER=http://localhost:3000/api

# Isi dengan nilai API_KEY pada latihan-fiber-api/.env (hanya untuk backend fiber).
# Nilai ini ikut terkompilasi ke bundel — jangan isi rahasia produksi.
VITE_API_KEY_FIBER=
